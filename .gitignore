# ==============================================================
# VJS TECH - Git Ignore Rules
# ==============================================================

# 1. Environment Variables & Secrets (CRITICAL - NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
server/.env
client/.env

# Allow environment templates
!.env.example
!server/.env.example
!client/.env.example

# 2. Dependencies
node_modules/
client/node_modules/
server/node_modules/

# 3. Production Build Artifacts
dist/
client/dist/
server/dist/
build/
*.tsbuildinfo

# 4. Database Files & Dynamic Runtime Data
*.db
*.db-journal
*.sqlite
data/*.db
data/*.sqlite
server/data/*.db
server/data/*.sqlite

# 5. Dynamic Uploads (Preserve directory structure via .gitkeep)
server/uploads/*
!server/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# 6. Logs & Debug Output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. Operating System & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
