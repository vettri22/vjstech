# ==============================================================
# VJS TECH Server Configuration (Production Environment Template)
# ==============================================================
# IMPORTANT: Copy this file to '.env' and populate with your own
# secure credentials. NEVER commit '.env' with real secrets to Git!

PORT=5000
NODE_ENV=production

# 64-character random string for cryptographic JWT token signing
JWT_SECRET=your_super_secret_jwt_random_key_change_in_production_min32chars

# Administrator Provisioning (Used on initial database initialization)
ADMIN_INITIAL_EMAIL=admin@vjstech.in
ADMIN_INITIAL_PASSWORD=SetYourStrongAdminPasswordHere_NeverShare

# Allowed CORS Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=https://vjstech.in,https://www.vjstech.in,http://localhost:3000

# Optional Google Search Console Verification ID
GOOGLE_SITE_VERIFICATION=

# Rate Limit Window & Request Bounds
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
